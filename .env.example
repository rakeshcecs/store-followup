# Deepak Silk Follow-up — environment settings.
# Copy this file to .env and fill in the values for the machine it runs on.

# ─── Database (required) ─────────────────────────────────────────────────────────────
# Local: WAMP MySQL 8 on port 3306. Put the password after "root:" if root has one.
DATABASE_URL="mysql://root:@localhost:3306/followup"

# ─── First admin (required for seeding) ──────────────────────────────────────────────
# Created by `npx prisma db seed` and by both reset commands below. The PIN must be
# changed at the first login. Mobile: 10 digits starting with 6, 7, 8 or 9.
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_MOBILE="9876543210"
SEED_ADMIN_PIN="1234"

# ─── Phone notifications (M14, Web Push) ─────────────────────────────────────────────
# Make a pair once per server and keep it: new keys cut off every phone that already
# allowed notifications.
#   npx web-push generate-vapid-keys
# Without them the app still works; reminders just stay in the bell list.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:owner@example.com"

# ─── WhatsApp (M22) ──────────────────────────────────────────────────────────────────
# The connection itself (phone number ID, business account ID, access token, app secret,
# webhook verify token) is entered in Settings → WhatsApp; the secrets are stored
# encrypted with this key. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it safe: without it the saved token cannot be read and must be entered again.
APP_ENCRYPTION_KEY=""
# Optional overrides for the Meta Graph API (defaults: https://graph.facebook.com, v23.0).
# WHATSAPP_GRAPH_URL=""
# WHATSAPP_GRAPH_VERSION=""

# ─── Nightly backup (M16.05) ─────────────────────────────────────────────────────────
# Written by the worker at 02:00 IST and kept 30 days. A folder on the server in India;
# leave empty on a laptop and no backup is scheduled.
#   npm run db:backup                         one backup now
#   npm run db:restore -- <file> <database>   load one back (steps in src/lib/backup.ts)
BACKUP_DIR=""
# Only when mysqldump / mysql are not on the PATH (e.g. WAMP on Windows):
# MYSQLDUMP_PATH="C:/wamp64/bin/mysql/mysql8.3.0/bin/mysqldump.exe"
# MYSQL_PATH="C:/wamp64/bin/mysql/mysql8.3.0/bin/mysql.exe"

# ─── Background worker ───────────────────────────────────────────────────────────────
# Optional: how often `npm run worker` checks for jobs (milliseconds, default 5000).
# WORKER_POLL_MS=5000

# ─── Local demo store (laptop only, never on a server) ───────────────────────────────
# Both commands wipe the local database, re-apply every migration and seed it again:
#   npm run db:reset        Deepak Silk – Branch A and the admin: what a new store looks like
#   npm run db:reset:demo   also Deepak Silk – Branch B and four staff, named after their
#                           home branch; prints the logins when it finishes:
#
#     Admin        9876543210   SEED_ADMIN_PIN (must change)   every branch
#     Manager A    9000000001   2580                           Branch A + Branch B
#     Manager B    9000000002   2580                           Branch B
#     Salesman A   9000000003   2580                           Branch A
#     Salesman B   9000000004   2580                           Branch B
#
# Manager A covers both branches, so the branch switcher and "All branches" can be tried
# by hand. The demo flag is part of the command, not a setting here, so this data can
# never reach a server by someone leaving a line switched on. The automated tests build
# their own data and ignore these rows.
#
# Only set these to change what `db:reset:demo` uses:
# SEED_DEMO_PIN="2580"                  # all four staff; not 1234/4321, which the app blocks
# SEED_MANAGER_MOBILE="9000000001"      # Manager A
# SEED_MANAGER2_MOBILE="9000000002"     # Manager B
# SEED_SALES_MOBILE="9000000003"        # Salesman A
# SEED_SALES2_MOBILE="9000000004"       # Salesman B
