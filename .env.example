# Copy to .env and adjust. Local DB = WAMP MySQL 8 on port 3306; set your password if root has one.
DATABASE_URL="mysql://root:@localhost:3306/followup"

# First admin created by `npx prisma db seed` (must change PIN on first login).
SEED_ADMIN_NAME="Store Admin"
SEED_ADMIN_MOBILE="9876543210"
SEED_ADMIN_PIN="1234"

# Optional: how often the worker checks for jobs (milliseconds, default 5000).
# WORKER_POLL_MS=5000

# Phone notifications (M14, Web Push). Make a pair once per server and keep it: new keys
# cut off every phone that already allowed notifications.
#   npx web-push generate-vapid-keys
# Without them the app still works; reminders just stay in the bell list.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:owner@example.com"

# Nothing below is needed to run the app.
#
#   npm run db:reset        one branch and the admin — what a real new store looks like
#   npm run db:reset:demo   two branches, a manager and a salesperson in each, plus the
#                           admin. The first manager covers both branches, so the branch
#                           switcher and "All branches" can be tried by hand. It prints
#                           the logins when it finishes.
#
# The demo flag is part of that command, not a setting here, so this data can never reach
# a server by someone leaving a line switched on. The automated tests build their own data
# and ignore these rows.
#
# Only set these to override what `db:reset:demo` uses:
# SEED_DEMO_PIN="2580"                  # all four demo staff; not 1234/4321, which the app blocks
# SEED_MANAGER_MOBILE="9000000001"      # manager, main branch + branch 2
# SEED_MANAGER2_MOBILE="9000000002"     # manager, branch 2
# SEED_SALES_MOBILE="9000000003"        # salesperson, main branch
# SEED_SALES2_MOBILE="9000000004"       # salesperson, branch 2