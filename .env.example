# Copy to .env and adjust. Local DB = WAMP MySQL 8 on port 3306; set your password if root has one.
DATABASE_URL="mysql://root:@localhost:3306/followup"

# First admin created by `npx prisma db seed` (must change PIN on first login).
SEED_ADMIN_NAME="Store Admin"
SEED_ADMIN_MOBILE="9876543210"
SEED_ADMIN_PIN="1234"

# Optional: how often the worker checks for jobs (milliseconds, default 5000).
# WORKER_POLL_MS=5000

# Seed a second branch and demo staff for trying multi-branch. Never set in production.
# SEED_DEMO="true"
# SEED_MANAGER_MOBILE="9000000001"
# SEED_SALES_MOBILE="9000000002"
